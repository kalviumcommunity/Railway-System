// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum Role {
  ADMIN
  KITCHEN
  PANTRY
}

enum KitchenStatus {
  ACTIVE
  BLOCKED
}

enum BatchStatus {
  CREATED
  DISPATCHED
  RECEIVED
  EXPIRED
}

enum EventType {
  CREATED
  DISPATCHED
  RECEIVED
  COMPLAINT
}

// ============ MODELS ============

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(KITCHEN)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Kitchen {
  id        String        @id @default(uuid())
  name      String
  status    KitchenStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  batches   Batch[]
}

model Batch {
  id           String        @id @default(uuid())
  kitchenId    String
  kitchen      Kitchen       @relation(fields: [kitchenId], references: [id])
  supplierName String
  status       BatchStatus   @default(CREATED)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime
  events       BatchEvent[]
  complaints   Complaint[]
}

model BatchEvent {
  id        String    @id @default(uuid())
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id])
  eventType EventType
  actorRole Role
  createdAt DateTime  @default(now())
}

model Complaint {
  id        String   @id @default(uuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id])
  trainNo   String
  message   String
  createdAt DateTime @default(now())
}

